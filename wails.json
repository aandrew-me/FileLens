{
  "$schema": "https://wails.io/schemas/config.v2.json",
  "name": "FileLens",
  "version": "1.0.2",
  "outputfilename": "FileLens",
  "frontend:install": "npm install",
  "frontend:build": "npm run build",
  "frontend:dev:watcher": "npm run dev",
  "frontend:dev:serverUrl": "auto",
  "author": {
    "name": "aandrew-me",
    "email": "aandrew.me@proton.me"
  },
  "info": {
    "companyName": "aandrew-me",
    "productName": "FileLens",
    "productVersion": "1.0.2",
    "copyright": "Copyright 2026 aandrew-me",
    "comments": "Video & Media Inspector",
    "fileAssociations": [
      {
        "ext": "mp4",
        "name": "MP4 Video",
        "description": "MP4 Video File",
        "iconName": "appicon",
        "role": "Viewer"
      },
      {
        "ext": "mkv",
        "name": "Matroska Video",
        "description": "Matroska Video File",
        "iconName": "appicon",
        "role": "Viewer"
      },
      {
        "ext": "mov",
        "name": "QuickTime Video",
        "description": "QuickTime Video File",
        "iconName": "appicon",
        "role": "Viewer"
      },
      {
        "ext": "avi",
        "name": "AVI Video",
        "description": "AVI Video File",
        "iconName": "appicon",
        "role": "Viewer"
      },
      {
        "ext": "webm",
        "name": "WebM Video",
        "description": "WebM Video File",
        "iconName": "appicon",
        "role": "Viewer"
      },
      {
        "ext": "mp3",
        "name": "MP3 Audio",
        "description": "MP3 Audio File",
        "iconName": "appicon",
        "role": "Viewer"
      },
      {
        "ext": "flac",
        "name": "FLAC Audio",
        "description": "FLAC Audio File",
        "iconName": "appicon",
        "role": "Viewer"
      },
      {
        "ext": "wav",
        "name": "WAV Audio",
        "description": "WAV Audio File",
        "iconName": "appicon",
        "role": "Viewer"
      }
    ]
  }
}
